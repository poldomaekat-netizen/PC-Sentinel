<Window x:Class="PCSentinel.App.WidgetWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:PCSentinel.App.Controls"
 Title="PC Sentinel · Widget" Style="{StaticResource {x:Type Window}}" Width="320" Height="242" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="Manual" MouseLeftButtonDown="Widget_MouseDown">
 <Border x:Name="WidgetSurface" BorderBrush="#456170" BorderThickness="1" CornerRadius="12">
  <Viewbox Stretch="Uniform"><Grid Width="318" Height="240" Margin="0"><Grid.RowDefinitions><RowDefinition Height="33"/><RowDefinition Height="100"/><RowDefinition Height="22"/><RowDefinition Height="31"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Margin="12,4,6,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="PinButton" Content="◇" Click="Pin_Click" Padding="7,3" ToolTip="Закрепить положение"/><Button Content="−" Click="Hide_Click" Padding="7,3" ToolTip="Свернуть в трей"/></StackPanel><TextBlock Text="◉  PC SENTINEL" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/></DockPanel>
   <ItemsControl Grid.Row="1" ItemsSource="{Binding WidgetCards}" Margin="8,1,8,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource Panel}" CornerRadius="7" Margin="2,0" Padding="1,3"><StackPanel ToolTip="{Binding Tooltip}"><TextBlock Text="{Binding Tag}" FontSize="9" HorizontalAlignment="Center" Foreground="{DynamicResource Muted}"/><c:Gauge Height="65" Value="{Binding Value}" Label="{Binding Label}" Caption="" Warning="{Binding Warning}" Critical="{Binding Critical}"/><Viewbox Height="10" Stretch="Fill" Margin="4,0"><Canvas Width="215" Height="30"><Polyline Points="{Binding Plot}" Stroke="{DynamicResource Accent}" StrokeThickness="1.6"/></Canvas></Viewbox></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="{Binding CpuTemperature}" ToolTip="{Binding CpuTemperatureHint}" FontSize="9" Foreground="{Binding CpuTemperatureColor}" Margin="4,0"/><TextBlock Text="{Binding GpuTemperature}" ToolTip="{Binding GpuTemperatureHint}" FontSize="9" Foreground="{Binding GpuTemperatureColor}" Margin="4,0"/><TextBlock Text="{Binding SsdTemperature}" ToolTip="{Binding SsdTemperatureHint}" FontSize="9" Foreground="{Binding SsdTemperatureColor}" Margin="4,0"/></StackPanel>
   <Border x:Name="NetworkBand" Grid.Row="3" Background="{DynamicResource Panel}" CornerRadius="5" Margin="11,0,11,4" Padding="8,4"><TextBlock Text="{Binding NetworkShort}" FontSize="11" HorizontalAlignment="Center"/></Border>
   <Border x:Name="VpnBand" Grid.Row="4" Margin="12,1,12,5" Background="{DynamicResource Panel}" CornerRadius="5" Padding="6,3" ToolTip="{Binding IpTooltip}"><StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{Binding IpColor}" Margin="0,0,6,0"/><TextBlock Text="{Binding IpStatus}" FontSize="10" Foreground="{Binding IpColor}"/></StackPanel><TextBlock Text="{Binding WidgetIp}" FontFamily="Consolas" FontSize="13" Margin="12,2,0,0"/></StackPanel></Border>
  </Grid></Viewbox>
 </Border>
</Window>

