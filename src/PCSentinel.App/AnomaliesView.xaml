<UserControl x:Class="PCSentinel.App.AnomaliesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="3*"/></Grid.RowDefinitions>
  <TextBlock Text="{Binding AnalysisSummary}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource Muted}"/>
  <WrapPanel Grid.Row="1"><ComboBox x:Name="GroupFilter" SelectedIndex="0" SelectionChanged="Filter_Changed" Width="190" Margin="0,0,8,5"><ComboBoxItem Content="Все группы"/><ComboBoxItem Content="Производительность"/><ComboBoxItem Content="События безопасности"/></ComboBox><Button Content="Обновить" Click="Reload_Click"/><Button Content="Экспорт JSON / CSV…" Click="Export_Click"/></WrapPanel>
  <DataGrid Grid.Row="2" x:Name="IncidentGrid" ItemsSource="{Binding Incidents}" SelectionChanged="Incident_Changed"><DataGrid.Columns><DataGridTextColumn Header="Начало" Binding="{Binding Time}" SortMemberPath="StartedUtc" Width="100"/><DataGridTextColumn Header="Правило" Binding="{Binding Rule}" Width="140"/><DataGridTextColumn Header="Уровень" Binding="{Binding Severity}" Width="75"/><DataGridTextColumn Header="Процессы" Binding="{Binding ProcessNames}" Width="*"/><DataGridTextColumn Header="Статус" Binding="{Binding State}" Width="85"/><DataGridCheckBoxColumn Header="Ожидаемое" Binding="{Binding Expected}" Width="80"/></DataGrid.Columns></DataGrid>
  <WrapPanel Grid.Row="3" Margin="0,6"><Button Content="Показать процесс" Click="Process_Click"/><Button Content="Расположение файла" Click="Folder_Click"/><Button Content="Ожидаемое" Click="Expected_Click"/><Button Content="Игнорировать правило…" Click="IgnoreRule_Click"/><Button Content="Игнорировать процесс…" Click="IgnoreProcess_Click"/><Button Content="Контекст ±5 мин" Click="Context_Click"/></WrapPanel>
  <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="CPU — бирюзовый · RAM — жёлтый · физический диск — голубой · 0–100%" Foreground="{DynamicResource Muted}" FontSize="10"/>
   <Viewbox Stretch="Fill" Height="100" Margin="0,4"><Canvas Width="600" Height="100" Background="{DynamicResource Panel}"><Polyline Points="{Binding IncidentCpuPlot}" Stroke="#24CDB4" StrokeThickness="1.5"/><Polyline Points="{Binding IncidentRamPlot}" Stroke="#F4B740" StrokeThickness="1.5"/><Polyline Points="{Binding IncidentDiskPlot}" Stroke="#91B9D9" StrokeThickness="1.5"/></Canvas></Viewbox>
   <TextBox Text="{Binding IncidentDetails,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Padding="7"/>
  </StackPanel></ScrollViewer>
 </Grid>
</UserControl>
