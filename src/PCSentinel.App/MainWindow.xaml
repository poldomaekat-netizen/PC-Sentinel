<Window x:Class="PCSentinel.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:PCSentinel.App.Controls" xmlns:local="clr-namespace:PCSentinel.App"
 Title="PC Sentinel · Glass Edition" Style="{StaticResource {x:Type Window}}" Width="960" Height="660" MinWidth="690" MinHeight="520" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen">
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="46" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
 <Border x:Name="ChromeSurface" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12">
  <Grid Margin="17,10,17,10"><Grid.RowDefinitions><RowDefinition Height="43"/><RowDefinition Height="*"/><RowDefinition Height="25"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="◉" Foreground="{DynamicResource Accent}" FontSize="22" Margin="0,0,9,0"/><TextBlock Text="PC Sentinel" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="GLASS 0.3" Foreground="{DynamicResource Muted}" FontSize="9" Margin="9,7,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
     <Ellipse Fill="{Binding IpColor}" Width="7" Height="7" Margin="4,0,7,0"/><TextBlock Text="{Binding TopIp}" ToolTip="{Binding IpTooltip}" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="0,0,13,0" FontSize="11"/>
     <Button Content="▦" ToolTip="Открыть виджет" Click="Compact_Click" Padding="9,5"/><Button Content="⚙" ToolTip="Настройки" Click="Settings_Click" Padding="9,5"/>
     <Button Content="—" Click="Minimize_Click" Padding="9,5"/><Button Content="□" Click="Maximize_Click" Padding="9,5"/><Button Content="×" Click="Close_Click" Padding="9,5"/>
    </StackPanel>
   </Grid>
   <TabControl Grid.Row="1" x:Name="Tabs">
    <TabItem Header="Обзор"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <ItemsControl ItemsSource="{Binding Cards}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><c:AdaptivePanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
      <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0.5" CornerRadius="10" Padding="12,9" Margin="0,0,8,8" Height="145" ToolTip="{Binding Tooltip}">
       <Grid><Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="*"/><RowDefinition Height="22"/></Grid.RowDefinitions>
        <DockPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Tag}" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}" FontSize="9"/></DockPanel>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="91"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><c:Gauge Value="{Binding Value}" Label="{Binding Label}" Caption="{Binding Caption}" Warning="{Binding Warning}" Critical="{Binding Critical}" Width="86" Height="81"/><TextBlock Grid.Column="1" Text="{Binding Detail}" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="8,0,0,0"/></Grid>
        <Viewbox Grid.Row="2" Stretch="Fill"><Canvas Width="215" Height="30"><Line X1="0" X2="215" Y1="29" Y2="29" Stroke="#304354"/><Polyline Points="{Binding Plot}" Stroke="{DynamicResource Accent}" StrokeThickness="1.2"/></Canvas></Viewbox>
       </Grid>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <Border Background="{DynamicResource Panel}" CornerRadius="8" Padding="12,9" Margin="0,1,8,9" ToolTip="{Binding SensorSummary}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding CpuTemperature}" ToolTip="{Binding CpuTemperatureHint}" Foreground="{Binding CpuTemperatureColor}"/><TextBlock Grid.Column="1" Text="{Binding GpuTemperature}" ToolTip="{Binding GpuTemperatureHint}" Foreground="{Binding GpuTemperatureColor}"/><TextBlock Grid.Column="2" Text="{Binding SsdTemperature}" ToolTip="{Binding SsdTemperatureHint}" Foreground="{Binding SsdTemperatureColor}"/></Grid></Border>
     <Border Background="#182D35" BorderBrush="#2B4D51" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,8,0" ToolTip="{Binding Route}">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="IP-КОНТРОЛЬ" FontSize="9" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding IpStatus}" TextWrapping="Wrap" Foreground="{Binding IpColor}" FontWeight="SemiBold" FontSize="16" Margin="0,3,0,0"/></StackPanel>
       <StackPanel Grid.Column="1"><TextBlock FontSize="10"><Run Text="{Binding Ip4,Mode=OneWay}"/><Run Text="   "/><Run Text="{Binding Ip6,Mode=OneWay}"/></TextBlock><TextBlock Text="{Binding IpTooltip}" FontSize="10" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,5,8,0"/></StackPanel>
       <Button Grid.Column="2" Content="↻" Click="CheckIp_Click" IsEnabled="{Binding CanCheckIp}" VerticalAlignment="Center" Margin="0" Padding="10,6"/>
      </Grid>
     </Border>
     <TextBlock Text="{Binding VpnStatus,StringFormat=VPN Guard: {0}}" ToolTip="{Binding VpnReason}" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,5"/>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Процессы"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Срез 5 с · CPU нормализован на все потоки · до 100 процессов, сортировка по колонкам" Style="{StaticResource MutedText}"/>
     <DataGrid x:Name="ProcessGrid" Grid.Row="1" ItemsSource="{Binding Processes}"><DataGrid.Columns><DataGridTextColumn Header="Процесс" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="65"/><DataGridTextColumn Header="CPU %" Binding="{Binding CpuPct,StringFormat=F1}" Width="75"/><DataGridTextColumn Header="RAM, байт" Binding="{Binding WorkingSetBytes,StringFormat=N0}" Width="125"/><DataGridTextColumn Header="Путь" Binding="{Binding Path}" Width="2*"/></DataGrid.Columns></DataGrid>
    </Grid></TabItem>
    <TabItem Header="Оборудование"><TabControl>
     <TabItem Header="Датчики"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="{Binding SensorSummary}" Style="{StaticResource MutedText}"/>
      <DataGrid Grid.Row="1" ItemsSource="{Binding Sensors}"><DataGrid.Columns><DataGridTextColumn Header="Устройство" Binding="{Binding Hardware}" Width="*"/><DataGridTextColumn Header="Датчик" Binding="{Binding Name}" Width="110"/><DataGridTextColumn Header="Сейчас" Binding="{Binding Value}" Width="92"/><DataGridTextColumn Header="Макс." Binding="{Binding Maximum}" Width="75"/><DataGridTemplateColumn Header="5 минут" Width="95"><DataGridTemplateColumn.CellTemplate><DataTemplate><Viewbox Stretch="Fill" Height="20"><Canvas Width="150" Height="25"><Polyline Points="{Binding Plot}" Stroke="{DynamicResource Accent}" StrokeThickness="1.5"/></Canvas></Viewbox></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Источник" Binding="{Binding Source}" Width="120"/><DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/><DataGridTextColumn Header="Время" Binding="{Binding Timestamp}" Width="75"/><DataGridTextColumn Header="Пояснение" Binding="{Binding Reason}" Width="200"/></DataGrid.Columns></DataGrid>
     </Grid></TabItem>
     <TabItem Header="Конфигурация"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Button Content="Обновить WMI" Click="Inventory_Click" HorizontalAlignment="Left" IsEnabled="{Binding CanInventory}"/><DataGrid Grid.Row="1" ItemsSource="{Binding Hardware}"><DataGrid.Columns><DataGridTextColumn Header="Тип" Binding="{Binding ComponentType}" Width="60"/><DataGridTextColumn Header="Компонент" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Сведения" Binding="{Binding Details}" Width="3*"/></DataGrid.Columns></DataGrid></Grid></TabItem>
    </TabControl></TabItem>
    <TabItem Header="История"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><Button Content="Последние пробы" Click="Report_Click"/><Button Content="Экспорт JSON…" Click="Export_Click"/></StackPanel><TextBox Grid.Row="1" Text="{Binding Report,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/></Grid></TabItem>
    <TabItem Header="События"><DataGrid ItemsSource="{Binding Events}"><DataGrid.Columns><DataGridTextColumn Header="Время UTC" Binding="{Binding TimestampUtc,StringFormat=yyyy-MM-dd HH:mm:ss}" Width="145"/><DataGridTextColumn Header="Источник" Binding="{Binding Type}" Width="90"/><DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="4"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns></DataGrid></TabItem>
    <TabItem Header="Аномалии"><local:AnomaliesView/></TabItem>
    <TabItem Header="Настройки"><local:SettingsView/></TabItem>
   </TabControl>
   <DockPanel Grid.Row="2" Margin="0,7,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding Updated}" Foreground="{DynamicResource Muted}" FontSize="10"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis"/></DockPanel>
  </Grid>
 </Border>
</Window>

