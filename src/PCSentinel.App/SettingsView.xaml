<UserControl x:Class="PCSentinel.App.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ListBox x:Name="SettingsNav" SelectedIndex="0"><ListBoxItem Content="Общие"/><ListBoxItem Content="Сеть / IP-контроль"/><ListBoxItem Content="Виджет"/><ListBoxItem Content="Температуры"/><ListBoxItem Content="История"/><ListBoxItem Content="Диагностика"/><ListBoxItem Content="Анализ"/></ListBox>
  <TabControl Grid.Column="1" x:Name="Pages" SelectedIndex="{Binding SelectedIndex,ElementName=SettingsNav}" Style="{StaticResource ContentTabs}" Margin="14,0,0,0">
   <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
    <TextBlock Text="Общие настройки" FontSize="20"/><TextBlock Text="Glass Edition · основные функции без прав администратора" Style="{StaticResource MutedText}"/>
    <CheckBox Content="Закрытие главного окна сворачивает в трей" IsChecked="{Binding Settings.MinimizeToTray}"/>
    <CheckBox Content="Главное окно поверх остальных" IsChecked="{Binding Settings.AlwaysOnTop}"/>
    <CheckBox Content="Автозагрузка текущего пользователя" IsChecked="{Binding Settings.AutoStart}"/>
    <CheckBox Content="Уведомления Windows" IsChecked="{Binding Settings.EnableNotifications}"/>
    <TextBlock Text="Прозрачность только фона, 0–75%" Margin="0,8,0,0"/><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Settings.BackgroundTransparency,StringFormat={}{0}%}" Margin="12,6,0,0"/><Slider Minimum="0" Maximum="75" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Settings.BackgroundTransparency,UpdateSourceTrigger=PropertyChanged}" ValueChanged="Transparency_Changed" Margin="0,8"/></DockPanel>
    <TextBlock Text="{Binding AppearanceStatus}" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,3,0,8"/>
    <TextBlock Text="Карточки и текст непрозрачны. Если эффекты Windows выключены или включён высокий контраст, используется непрозрачный фон." Style="{StaticResource MutedText}"/>
    <UniformGrid Columns="3"><StackPanel Margin="0,0,10,0"><TextBlock Text="Обновление, с"/><TextBox Text="{Binding Settings.RefreshSeconds}"/></StackPanel><StackPanel Margin="0,0,10,0"><TextBlock Text="Жёлтый порог, %"/><TextBox Text="{Binding Settings.WarningThreshold}"/></StackPanel><StackPanel><TextBlock Text="Красный порог, %"/><TextBox Text="{Binding Settings.CriticalThreshold}"/></StackPanel></UniformGrid>
    <UniformGrid Columns="2"><StackPanel Margin="0,0,10,0"><TextBlock Text="Задержка уведомления, с"/><TextBox Text="{Binding Settings.AlertDurationSeconds}"/></StackPanel><StackPanel><TextBlock Text="Повтор не чаще, с"/><TextBox Text="{Binding Settings.AlertCooldownSeconds}"/></StackPanel></UniformGrid>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
    <TextBlock Text="Сеть / IP-контроль" FontSize="20"/>
    <TextBlock Text="Доверенный публичный IP (IPv4)" Margin="0,12,0,3"/><TextBox Text="{Binding Settings.TrustedPublicIp,UpdateSourceTrigger=PropertyChanged}" ToolTip="Один публичный IPv4 без CIDR; private/reserved адреса не допускаются"/>
    <WrapPanel><Button Content="Использовать текущий IP как доверенный…" Click="TrustCurrent_Click"/><Button Content="Проверить сейчас" Click="Check_Click" IsEnabled="{Binding CanCheckIp}"/></WrapPanel>
    <CheckBox Content="Проверять автоматически (два независимых HTTPS-сервиса)" IsChecked="{Binding Settings.EnablePublicIp}"/>
    <TextBlock Text="{Binding CurrentIpDetails}" TextWrapping="Wrap" Margin="0,5,0,5"/><TextBlock Text="{Binding IpStatus}" Foreground="{Binding IpColor}" FontSize="17" FontWeight="SemiBold"/>
    <TextBlock Text="ipify.org и icanhazip.com видят исходящий IP самого PC Sentinel. Другие приложения при split tunneling могут использовать иной маршрут. Совпадение IP не означает защиту VPN." Style="{StaticResource MutedText}"/>
    <Expander Header="Расширенный доверенный IPv6" Foreground="{DynamicResource Muted}"><StackPanel><TextBox Text="{Binding Settings.TrustedPublicIpv6}"/><TextBlock Text="IPv6 сравнивается только со своим семейством; основной индикатор относится к IPv4." TextWrapping="Wrap"/></StackPanel></Expander>
    <TextBlock Text="VPN Guard · отдельная проверка туннеля" FontSize="16" Margin="0,18,0,0"/><TextBlock Text="1. Подключите VPN → 2. Проверьте соединение → 3. Запомните профиль" Style="{StaticResource MutedText}"/>
    <CheckBox x:Name="AutoMode" Content="Автоматически определять VPN (рекомендуется)" IsChecked="{Binding Settings.AutoDetectVpn}" Checked="Mode_Changed" Unchecked="Mode_Changed"/>
    <ComboBox x:Name="ManualAdapter" ItemsSource="{Binding Adapters}" SelectedValuePath="Id" SelectedValue="{Binding Settings.PreferredAdapterId}" ToolTip="Ручной выбор применяется при выключенном автоматическом режиме"/>
    <TextBlock Text="{Binding AdapterSummary}" Style="{StaticResource MutedText}"/>
    <TextBlock Text="ipify.org и icanhazip.com технически видят исходящий IP. Cookie, авторизация и история им не передаются." Style="{StaticResource MutedText}"/>
    <WrapPanel><Button Content="Проверить IP и маршруты" Click="Check_Click"/><Button Content="Запомнить защищённое соединение" Click="Remember_Click" IsEnabled="{Binding CanCaptureProfile}"/></WrapPanel>
    <Border Background="{DynamicResource Panel}" CornerRadius="7" Padding="10" Margin="0,3,0,9"><StackPanel><TextBlock Text="{Binding ProfileSummary}" TextWrapping="Wrap"/><TextBlock Text="{Binding Ip4}" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/><TextBlock Text="{Binding Ip6}" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding VpnReason}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/></StackPanel></Border>
    <TextBlock Text="Доступность сайтов ≠ доказательство VPN" FontWeight="SemiBold"/>
    <CheckBox Content="Проверять DNS и HTTPS контрольных сайтов" IsChecked="{Binding Settings.EnableSiteChecks}"/>
    <ListBox x:Name="SiteList" ItemsSource="{Binding Settings.ControlSites}" MaxHeight="155"><ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding Url}" IsChecked="{Binding Enabled}" Margin="0"/></DataTemplate></ListBox.ItemTemplate></ListBox>
    <DockPanel><Button DockPanel.Dock="Right" Content="Удалить свой" Click="RemoveSite_Click"/><Button DockPanel.Dock="Right" Content="Добавить" Click="AddSite_Click"/><TextBox x:Name="NewSite" ToolTip="Свой HTTPS-адрес без логина, query или fragment"/></DockPanel>
    <TextBlock Text="Интервал IP / сайтов, 15–600 секунд"/><TextBox Text="{Binding Settings.NetworkIntervalSeconds}" Width="110" HorizontalAlignment="Left"/>
    <DataGrid ItemsSource="{Binding Sites}" MaxHeight="160"><DataGrid.Columns><DataGridTextColumn Header="Сайт" Binding="{Binding Url}" Width="*"/><DataGridTextColumn Header="DNS ms" Binding="{Binding DnsMs,StringFormat=F0}" Width="65"/><DataGridTextColumn Header="HTTPS ms" Binding="{Binding HttpsMs,StringFormat=F0}" Width="75"/><DataGridTextColumn Header="HTTP" Binding="{Binding HttpStatus}" Width="55"/><DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120"/></DataGrid.Columns></DataGrid>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
    <TextBlock Text="Desktop widget" FontSize="20"/><TextBlock Text="Общий поток данных с главным окном. Перетаскивайте свободную область; двойной клик открывает панель." Style="{StaticResource MutedText}"/>
    <WrapPanel><CheckBox Content="Показывать при запуске" IsChecked="{Binding Settings.Widget.VisibleOnStartup}" Margin="0,6,20,8"/><CheckBox Content="Компактный 260 × 197" IsChecked="{Binding Settings.Widget.Compact}"/></WrapPanel>
    <WrapPanel><CheckBox Content="Поверх всех окон" IsChecked="{Binding Settings.Widget.Topmost}" Margin="0,6,20,8"/><CheckBox Content="Закрепить положение" IsChecked="{Binding Settings.Widget.Locked}"/></WrapPanel>
    <TextBlock Text="Масштаб, 0.75–2"/><Slider Minimum="0.75" Maximum="2" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding Settings.Widget.Scale}" Margin="0,8"/>
    <TextBlock Text="Прозрачность только фона, 0–75%"/><Slider Minimum="0" Maximum="75" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Settings.Widget.BackgroundTransparency,UpdateSourceTrigger=PropertyChanged}" ValueChanged="Transparency_Changed" Margin="0,8"/>
    <UniformGrid Columns="3"><CheckBox Content="CPU" IsChecked="{Binding Settings.Widget.ShowCpu}"/><CheckBox Content="RAM" IsChecked="{Binding Settings.Widget.ShowRam}"/><CheckBox Content="GPU" IsChecked="{Binding Settings.Widget.ShowGpu}"/><CheckBox Content="SSD / диск" IsChecked="{Binding Settings.Widget.ShowDisk}"/><CheckBox Content="Сеть" IsChecked="{Binding Settings.Widget.ShowNetwork}"/><CheckBox Content="IP" IsChecked="{Binding Settings.Widget.ShowVpn}"/></UniformGrid>
    <TextBlock Text="Монитор"/><ComboBox x:Name="MonitorList" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding Settings.Widget.MonitorDevice}"/>
    <TextBlock Text="Привязка"/><ComboBox SelectedValue="{Binding Settings.Widget.Dock}" SelectedValuePath="Tag"><ComboBoxItem Content="Свободно" Tag="None"/><ComboBoxItem Content="Слева сверху" Tag="TopLeft"/><ComboBoxItem Content="Справа сверху" Tag="TopRight"/><ComboBoxItem Content="Слева снизу" Tag="BottomLeft"/><ComboBoxItem Content="Справа снизу" Tag="BottomRight"/><ComboBoxItem Content="Левый край" Tag="Left"/><ComboBoxItem Content="Правый край" Tag="Right"/><ComboBoxItem Content="Верхний край" Tag="Top"/><ComboBoxItem Content="Нижний край" Tag="Bottom"/></ComboBox>
    <TextBlock Text="При отключении экрана виджет возвращается в доступную рабочую область. Always on Top по умолчанию выключен." Style="{StaticResource MutedText}"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
    <TextBlock Text="Температурные пороги" FontSize="20"/><TextBlock Text="Порог зависит от устройства. Значения ниже — пользовательские ориентиры, а не универсальные пределы производителя; уточните спецификации своего оборудования." Style="{StaticResource MutedText}"/>
    <UniformGrid Columns="3"><TextBlock Text="Устройство"/><TextBlock Text="Предупреждение, °C"/><TextBlock Text="Критический, °C"/><TextBlock Text="CPU Package" VerticalAlignment="Center"/><TextBox Text="{Binding Settings.CpuTemperatureWarning}" Margin="0,4,10,9"/><TextBox Text="{Binding Settings.CpuTemperatureCritical}"/><TextBlock Text="GPU" VerticalAlignment="Center"/><TextBox Text="{Binding Settings.GpuTemperatureWarning}" Margin="0,4,10,9"/><TextBox Text="{Binding Settings.GpuTemperatureCritical}"/><TextBlock Text="SSD / NVMe" VerticalAlignment="Center"/><TextBox Text="{Binding Settings.SsdTemperatureWarning}" Margin="0,4,10,9"/><TextBox Text="{Binding Settings.SsdTemperatureCritical}"/></UniformGrid>
    <TextBlock Text="Аппаратные температуры CPU / Intel GT" FontSize="17" Margin="0,12,0,4"/>
    <TextBlock Text="Аппаратные температуры читает служба из защищённой установки в Program Files. UAC нужен только установщику. Основное окно не повышает права и не запускает EXE-помощник. В переносной версии доступны только штатные источники без привилегированного доступа." Style="{StaticResource MutedText}"/>
    <WrapPanel Margin="0,5"><Button Content="Подключить службу CPU/GPU" Click="EnableHardwareTemperatures_Click"/><Button Content="Отключить подключение" Click="DisableHardwareTemperatures_Click" Margin="8,0,0,0"/></WrapPanel>
    <TextBlock Text="{Binding HardwareTemperatureStatus}" Foreground="{DynamicResource Accent}" TextWrapping="Wrap"/>
    <TextBlock Text="Дополнительные источники: NVIDIA NVML, AMD ADLX, Intel IGCL, Windows WDDM, Storage IOCTL/CIM и установленный PresentMon. Драйверы автоматически не скачиваются и не устанавливаются. CPU и GPU читаются раздельно; недоступные датчики показывают «—»." Style="{StaticResource MutedText}"/>
    <TextBlock Text="Текущие значения, максимум сеанса, источник, статус, динамика и время — в Оборудование → Датчики." TextWrapping="Wrap"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem><StackPanel Margin="0,0,12,0"><TextBlock Text="Хранение истории" FontSize="20"/><TextBlock Text="Миграция сохраняет данные v0.1/v0.2; перед изменением схемы создаётся SQLite backup. Настройки предыдущей версии сохраняются отдельной копией." Style="{StaticResource MutedText}"/>
    <UniformGrid Columns="3"><StackPanel Margin="0,0,10,0"><TextBlock Text="Сырые данные, дней"/><TextBox Text="{Binding Settings.RawHistoryDays}"/></StackPanel><StackPanel Margin="0,0,10,0"><TextBlock Text="Минутные, дней"/><TextBox Text="{Binding Settings.AggregateHistoryDays}"/></StackPanel><StackPanel><TextBlock Text="События, дней"/><TextBox Text="{Binding Settings.EventHistoryDays}"/></StackPanel></UniformGrid><TextBlock Text="{Binding DataPath}" Style="{StaticResource MutedText}"/><TextBlock Text="Экспорт JSON включает историю ресурсов, процессов, сетевые проверки и телеметрию датчиков. Исходная частота датчиков сохраняется; медленные аппаратные запросы не выполняются каждую секунду." Style="{StaticResource MutedText}"/>
   </StackPanel></TabItem>
   <TabItem><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Все интерфейсы · диагностический список" Style="{StaticResource MutedText}"/><DataGrid Grid.Row="1" ItemsSource="{Binding AllAdapters}"><DataGrid.Columns><DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/><DataGridCheckBoxColumn Header="Up" Binding="{Binding Up}" Width="40"/><DataGridTextColumn Header="Тип" Binding="{Binding Kind}" Width="85"/><DataGridTextColumn Header="Шлюз" Binding="{Binding Gateway}" Width="120"/></DataGrid.Columns></DataGrid><Expander Grid.Row="2" Header="Сохранённые legacy IP v0.1" Foreground="{DynamicResource Muted}" Margin="0,10"><TextBox Text="{Binding Settings.LegacyApprovedIps,Mode=OneWay}" IsReadOnly="True"/></Expander></Grid></TabItem>
   <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
    <TextBlock Text="Локальный анализ аномалий" FontSize="20"/><CheckBox Content="Анализировать нагрузку и создавать инциденты" IsChecked="{Binding Settings.Anomalies.Enabled}"/>
    <TextBlock Text="Фиксированные правила работают сразу; baseline median/MAD изучает до 7 дней, первые 24 часа — обучение. Диагностика не заменяет антивирус." Style="{StaticResource MutedText}"/>
    <UniformGrid Columns="3"><StackPanel Margin="0,0,8,0"><TextBlock Text="CPU, %"/><TextBox Text="{Binding Settings.Anomalies.CpuPct}"/></StackPanel><StackPanel Margin="0,0,8,0"><TextBlock Text="RAM, %"/><TextBox Text="{Binding Settings.Anomalies.RamPct}"/></StackPanel><StackPanel><TextBlock Text="Диск active, %"/><TextBox Text="{Binding Settings.Anomalies.DiskPct}"/></StackPanel></UniformGrid>
    <UniformGrid Columns="3"><StackPanel Margin="0,0,8,0"><TextBlock Text="Выдержка, с"/><TextBox Text="{Binding Settings.Anomalies.SustainedSeconds}"/></StackPanel><StackPanel Margin="0,0,8,0"><TextBlock Text="Восстановление, с"/><TextBox Text="{Binding Settings.Anomalies.RecoverySeconds}"/></StackPanel><StackPanel><TextBlock Text="Cooldown, с"/><TextBox Text="{Binding Settings.Anomalies.CooldownSeconds}"/></StackPanel></UniformGrid>
    <UniformGrid Columns="3"><StackPanel Margin="0,0,8,0"><TextBlock Text="I/O задержка, ms"/><TextBox Text="{Binding Settings.Anomalies.DiskLatencyMs}"/></StackPanel><StackPanel Margin="0,0,8,0"><TextBlock Text="Процесс CPU, %"/><TextBox Text="{Binding Settings.Anomalies.ProcessCpuPct}"/></StackPanel><StackPanel><TextBlock Text="Процесс RAM, MiB"/><TextBox Text="{Binding Settings.Anomalies.ProcessMemoryMb}"/></StackPanel></UniformGrid>
    <UniformGrid Columns="3"><StackPanel Margin="0,0,8,0"><TextBlock Text="Процесс выдержка, с"/><TextBox Text="{Binding Settings.Anomalies.ProcessSeconds}"/></StackPanel><StackPanel Margin="0,0,8,0"><TextBlock Text="Рост RAM, MiB / 10 мин"/><TextBox Text="{Binding Settings.Anomalies.MemoryGrowthMb}"/></StackPanel><StackPanel><TextBlock Text="Рост RAM, ×"/><TextBox Text="{Binding Settings.Anomalies.MemoryGrowthFactor}"/></StackPanel></UniformGrid>
    <UniformGrid Columns="2"><StackPanel Margin="0,0,8,0"><TextBlock Text="Всплеск сети, × median"/><TextBox Text="{Binding Settings.Anomalies.NetworkFactor}"/></StackPanel><StackPanel><TextBlock Text="Минимум сети, MiB/s"/><TextBox Text="{Binding Settings.Anomalies.NetworkMinimumMbps}"/></StackPanel></UniformGrid>
    <CheckBox Content="Скорость сети в Мбит/с (иначе КБ/МБ в секунду)" IsChecked="{Binding Settings.NetworkMegabits}"/>
    <CheckBox Content="Читать доступный журнал Microsoft Defender" IsChecked="{Binding Settings.ReadDefenderEvents}"/><CheckBox Content="Читать уже доступный Sysmon (не устанавливать / не включать)" IsChecked="{Binding Settings.ReadSysmonEvents}"/>
    <TextBlock Text="{Binding SecuritySources}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8"/>
    <TextBlock Text="Игнорируемые правила / пути" FontWeight="SemiBold"/><ListBox x:Name="IgnoreRules" ItemsSource="{Binding Settings.Anomalies.IgnoredRules}" MaxHeight="90"/><ListBox x:Name="IgnorePaths" ItemsSource="{Binding Settings.Anomalies.IgnoredPaths}" MaxHeight="90"/><Button Content="Удалить выбранные фильтры" Click="RemoveIgnore_Click" HorizontalAlignment="Left"/>
    <TextBlock Text="Подробные пробы сохраняются каждые 15 с для ограниченного набора ведущих процессов. I/O процесса включает все операции, не только диск. Точные per-process сетевые байты не измеряются; источник сетевого всплеска может быть неизвестен. Аргументы команд не собираются." Style="{StaticResource MutedText}"/>
   </StackPanel></ScrollViewer></TabItem>
  </TabControl>
  <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0"><Button DockPanel.Dock="Left" Content="Сохранить и применить" Click="Save_Click" Background="#21574F"/><TextBlock Text="{Binding SettingsMessage}" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="8,0,0,0"/></DockPanel>
 </Grid>
</UserControl>
